{
	"name": "fucodo/form-easy-mail",
	"description": "Simplifies the form mail finishers",
	"type": "typo3-cms-extension",
	"license": "GPL-2.0+",
	"require": {
		"typo3/cms-core": "^12 || ^13",
		"typo3/cms-form": "^12 || ^13" 
	},
	"autoload": {
		"classmap": ["Classes/"],
		"psr-4": {
			"Fucodo\\EasyMail\\": "Classes/"
		}
	},
	"homepage": "http://fucodo.de/",
	"extra": {
		"typo3/cms": {
			"extension-key": "form_easy_mail"
		}
	}
}
